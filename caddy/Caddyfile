{$AUTHELIA_CADDY_DOMAIN} {
 	reverse_proxy {$AUTHELIA_IP}:{$AUTHELIA_INTERNAL_PORT}
}


{$CF_TUNNEL_DOMAIN} {
	import secure *
	import cloudflare

	@service1 host {$MINIFLUX_CADDY_DOMAIN}
	reverse_proxy @service1 {$MINIFLUX_IP}:{$MINIFLUX_INTERNAL_PORT}

	@service2 host {$SEARXNG_CADDY_DOMAIN}
	reverse_proxy @service2 {$SEARXNG_IP}:{$SEARXNG_INTERNAL_PORT}
}
