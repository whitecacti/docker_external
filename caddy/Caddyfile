(secure) {
	forward_auth {args.0} {$AUTHELIA_IP}:{$AUTHELIA_INTERNAL_PORT} {
		uri /api/verify?rd={$AUTHELIA_HOSTNAME}
		copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
	}
}

