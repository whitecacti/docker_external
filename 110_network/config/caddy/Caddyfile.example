{
	debug
}

# Remember, when creating new certs sometimes you need to  
	# 1 - switch cf trunnels ssl/tls encryption to full
	# 2 - swith it back after

# below 2 lines need to be added to linux host in /etc/sysctl.conf
	# net.core.rmem_max=7500000
	# net.core.wmem_max=7500000

(cloudflare) {
	encode gzip
	tls {
		dns cloudflare {$CLOUDFLARE_DNS_TOKEN}
		resolvers 1.1.1.1
		propagation_delay 30s
	}
}

# From across the internet - https://caddy.community/t/securing-web-apps-with-caddy-and-authelia-in-docker-compose-an-opinionated-practical-and-minimal-production-ready-login-portal-guide/20465
