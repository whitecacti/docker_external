#adguard dns
adguard.{$DOMAIN} {
	import cloudflare
	reverse_proxy 192.168.1.1:0000
}

truenas.{$DOMAIN} {
	import cloudflare
	reverse_proxy http://192.168.1.1
}

rss.{$DOMAIN} {
	import cloudflare
	reverse_proxy 192.168.1.1:0000
}

audiobooks.{$DOMAIN} {
	import cloudflare
	reverse_proxy 192.168.1.1:0000
}

jupyter.{$DOMAIN} {
	import cloudflare
	reverse_proxy 192.168.1.1:0000
}

proxmox.{$DOMAIN} {
	import cloudflare
	reverse_proxy https://192.168.1.1:0000 {
		transport http {
			tls_insecure_skip_verify
		}
	}
}

wg.{$DOMAIN} {
	import cloudflare
	reverse_proxy 192.168.1.1:0000
}

syncthing.{$DOMAIN} {
	import cloudflare
	reverse_proxy 192.168.1.1:0000
}

homebox.{$DOMAIN} {
	import cloudflare
	reverse_proxy 192.168.1.1:0000
}

# arrrrr
deluge.{$DOMAIN} {
	import cloudflare
	reverse_proxy 192.168.1.1:0000
}

prowlarr.{$DOMAIN} {
	import cloudflare
	reverse_proxy 192.168.1.1:0000
}

sonarr.{$DOMAIN} {
	import cloudflare
	reverse_proxy 192.168.1.1:0000
}

radarr.{$DOMAIN} {
	import cloudflare
	reverse_proxy 192.168.1.1:0000
}

# tailscale availability
rss.ts.{$DOMAIN} {
	import cloudflare
	reverse_proxy 192.168.1.1:0000
}

jupyter.ts.{$DOMAIN} {
	import cloudflare
	reverse_proxy 192.168.1.1:0000
}

deluge.ts.{$DOMAIN} {
	import cloudflare
	reverse_proxy 192.168.1.1:0000
}

audiobooks.ts.{$DOMAIN} {
	import cloudflare
	reverse_proxy 192.168.1.1:0000
}